---
interface Props {
  date: Date;
  class?: string;
}
const { date, class: className } = Astro.props;
const iso = date.toISOString();
const label = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
---
<time datetime={iso} class={className}>{label}</time>
