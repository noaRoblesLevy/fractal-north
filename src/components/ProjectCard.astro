---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
}
const { entry } = Astro.props;
const { title, description, stack, status, github } = entry.data;
---
<article class="card card-project">
  <div class="project-top">
    <span class="pill">
      <span class="status-dot"></span>
      {status}
    </span>
    {github && (
      <a class="gh-link" href={github} target="_blank" rel="noopener" aria-label={`${title} on GitHub`}>
        <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38
            0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01
            1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95
            0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0
            1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0
            3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01
            8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
        </svg>
      </a>
    )}
  </div>
  <h3 class="card-title">{title}</h3>
  <p class="project-desc">{description}</p>
  <ul class="tag-row stack-row">
    {stack.map((s) => <li class="pill pill-stack">{s}</li>)}
  </ul>
</article>

<style>
  .project-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .gh-link {
    color: var(--text-muted);
    display: inline-flex;
  }
  .gh-link:hover {
    color: var(--link-hover);
  }
  .project-desc {
    color: var(--text-muted);
    line-height: 1.55;
  }
  .stack-row {
    margin-top: auto;
    padding-top: 0.5rem;
    gap: 0.4rem;
  }
  .pill-stack {
    font-size: 0.78rem;
    color: var(--text-muted);
    background: color-mix(in srgb, var(--surface-2) 60%, transparent);
  }
</style>
