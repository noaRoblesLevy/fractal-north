---
interface Props {
  title?: string;
}
const { title } = Astro.props;
---
<aside class="callout">
  <span class="callout-mark" aria-hidden="true">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8" />
      <path d="M12 11v5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      <circle cx="12" cy="7.75" r="1.2" fill="currentColor" />
    </svg>
  </span>
  <div class="callout-body">
    {title && <p class="callout-title">{title}</p>}
    <slot />
  </div>
</aside>

<style>
  .callout {
    display: flex;
    gap: 0.85rem;
    margin-block: 1.75rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--border-strong);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--cobalt) 8%, var(--surface));
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--text-muted);
  }
  .callout-mark {
    flex: none;
    color: var(--azure);
    margin-top: 0.1rem;
  }
  .callout-title {
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.25rem;
  }
  .callout-body :global(p) {
    margin: 0;
  }
  .callout-body :global(p + p) {
    margin-top: 0.6rem;
  }
</style>
